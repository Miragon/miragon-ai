{
  "realm": "miragon",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "miragon-ai-server",
      "name": "Automation MCP server (oidc-proxy client)",
      "description": "Pre-registered confidential client the MCP server's oidc-proxy mode uses to broker MCP-client logins. Secret is demo-grade, matching the stack's demo/demo convention.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "miragon-ai-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8400/oauth/callback",
        "http://localhost:8401/oauth/callback",
        "http://localhost:8402/oauth/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "miragon-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "miragon-ai-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@miragon.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }]
    }
  ]
}
