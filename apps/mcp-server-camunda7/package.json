{
  "name": "@miragon-ai/mcp-server-camunda7",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/miragon-ai.git",
    "directory": "apps/mcp-server-camunda7"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-camunda7": "dist/index.js"
  },
  "scripts": {
    "build:ui": "vite build",
    "build:server": "tsc",
    "build": "pnpm run build:ui && pnpm run build:server",
    "dev:ui": "vite build --watch",
    "dev": "pnpm run build:ui && mcp-use dev --port ${PORT:-8400} --no-open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:host": "pnpm run build:ui && playwright test -c test-host",
    "lint": "eslint src test test-host",
    "lint:fix": "eslint src test test-host --fix",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@miragon-ai/analytics-connector": "workspace:*",
    "@miragon-ai/camunda7-connector": "workspace:*",
    "@miragon-ai/widget-shell": "workspace:*",
    "@miragon/mcp-toolkit-core": "2.0.0",
    "mcp-use": "2.1.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@miragon/mcp-toolkit-ui": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "10.1.0",
    "lucide-react": "0.562.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
