{
  "name": "@miragon-ai/analytics-connector",
  "version": "0.19.0",
  "description": "Prometheus-backed process-analytics MCP module: tools, dashboards, and comparison widgets.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "camunda",
    "process-analytics",
    "prometheus",
    "widgets"
  ],
  "homepage": "https://github.com/Miragon/miragon-ai/tree/main/packages/connectors/analytics/analytics-connector#readme",
  "bugs": "https://github.com/Miragon/miragon-ai/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/miragon-ai.git",
    "directory": "packages/connectors/analytics/analytics-connector"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": "./src/widgets/index.ts",
    "./definition": "./src/definition.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widgets.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@miragon-ai/analytics-client": "workspace:*",
    "@miragon-ai/widget-shell": "workspace:*"
  },
  "peerDependencies": {
    "@miragon/mcp-toolkit-core": "~2.6.0",
    "lucide-react": "^0.562.0 || ^1.0.0",
    "mcp-use": "2.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-core": "2.6.0",
    "@miragon/mcp-toolkit-ui": "2.6.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "bpmn-js": "18.30.1",
    "happy-dom": "20.14.5",
    "lucide-react": "0.562.0",
    "mcp-use": "2.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
