{
  "name": "@miragon-ai/analytics-client",
  "version": "0.10.0",
  "description": "Prometheus client and PromQL query functions for Camunda process analytics, with Zod schemas.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "prometheus",
    "promql",
    "process-analytics",
    "metrics",
    "mcp"
  ],
  "homepage": "https://github.com/Miragon/miragon-ai/tree/main/packages/connectors/analytics/analytics-client#readme",
  "bugs": "https://github.com/Miragon/miragon-ai/issues",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/miragon-ai.git",
    "directory": "packages/connectors/analytics/analytics-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "metrics-contract.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "import": "./dist/queries/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
