# Local configuration — copy to `.env` and adjust.
#
# Loaded by `pnpm dev` via dotenv-cli (plain KEY=VALUE lines, no `export`, no
# quotes around inline-JSON values); `pnpm start` and Docker take their config
# from the environment instead. Every variable here is read by this server —
# adding one it does NOT read prints an "Unknown environment variable"
# warning at boot.

# ── Server ────────────────────────────────────────────────────────────────
# HTTP port (default 8400).
# PORT=8400
# Public base URL when running behind a proxy or MCP gateway. Unset is right
# for local development.
# MCP_URL=https://mcp.example.com
# Comma-separated module selection; unset or "all" activates every module.
# A `module:toolset` suffix narrows a module's tool surface — camunda7
# supports read-only | operations | admin, analytics read-only.
# MCP_ACTIVE_MODULES=camunda7:read-only,analytics,notes
# mcp-use's log level (error | warn | info | debug).
# MCP_DEBUG_LEVEL=info

# ── Persistence (user profiles + saved dashboards) ────────────────────────
# Both default to in-memory, i.e. everything is lost on restart. Point them at
# a directory to persist across restarts.
# MCP_PROFILE_DIR=./.data/profiles
# MCP_DASHBOARD_DIR=./.data/dashboards
# Expiry for session-keyed profile records in days (default 30, `0` disables).
# MCP_PROFILE_SESSION_TTL_DAYS=30

# ── Camunda 7 / CIB Seven engine (camunda7 module) ────────────────────────
# The defaults below match the Docker Compose stack in the miragon-ai
# playground (https://github.com/Miragon/miragon-ai/tree/main/playground).
CAMUNDA_BASE_URL=http://localhost:8410/engine-rest
# Engine id for the single-engine shorthand above (default "default"). It MUST
# match the ENGINE_ID the engine stamps onto its metrics — that value becomes
# the `engine_id` label every engine-scoped analytics query joins on. A
# mismatch is silent: the queries simply return nothing.
CAMUNDA_ENGINE_ID=prod-a
# Browser-reachable cockpit base URL for "open in cockpit" links. Derived from
# CAMUNDA_BASE_URL per vendor when unset — set it explicitly whenever the
# engine URL above is not reachable from the user's browser (e.g. a container
# hostname).
# CAMUNDA_COCKPIT_URL=http://localhost:8410/webapp
# none | basic | bearer | passthrough. basic requires USERNAME + PASSWORD and
# bearer requires TOKEN — both are enforced at boot. passthrough forwards each
# MCP caller's own bearer token to the engine per request.
CAMUNDA_AUTH_TYPE=basic
CAMUNDA_USERNAME=demo
CAMUNDA_PASSWORD=demo
# CAMUNDA_TOKEN=...                       # only for CAMUNDA_AUTH_TYPE=bearer

# Multi-engine, overriding CAMUNDA_BASE_URL + CAMUNDA_ENGINE_ID. Each `id` is
# subject to the same match with the engine's own ENGINE_ID as above. Optional
# per entry: `flavor` ("cibseven" | "operaton" | "camunda7", default
# "cibseven") selects the vendor's cockpit routes, and `auth` overrides the
# global CAMUNDA_AUTH_TYPE settings. A JSON object instead of the array groups
# engines by environment ({"<environment>": [engines…]}) for the two-stage
# environment → engine pickers. CAMUNDA_ENGINES_FILE points at a file holding
# the same JSON and wins over both.
# CAMUNDA_ENGINES_JSON=[{"id":"prod-a","baseUrl":"http://localhost:8410/engine-rest"},{"id":"prod-b","baseUrl":"http://localhost:8411/engine-rest","flavor":"operaton"}]
# CAMUNDA_ENGINES_FILE=./engines.json

# owner/repo for "create an issue from this incident" handoffs.
# CAMUNDA_INCIDENT_ISSUE_REPO=acme/operations
# Thresholds above which the engine health check reports critical.
# CAMUNDA_HEALTH_CRITICAL_INCIDENTS=50
# CAMUNDA_HEALTH_CRITICAL_CLUSTER_SIZE=1

# ── Prometheus (analytics module) ─────────────────────────────────────────
# The playground stack publishes Prometheus on host port 8460. Unset defaults
# to http://localhost:9090, which does NOT match that stack — every analytics
# query then fails. The server warns at boot when this is unset.
PROMETHEUS_URL=http://localhost:8460

# ── Notes (the example custom module) ─────────────────────────────────────
# Heading shown in the notes widget (default "Team Notes").
# NOTES_TITLE=Team Notes
