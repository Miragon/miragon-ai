{
  "name": "@miragon-ai/camunda7-client",
  "version": "0.12.0",
  "description": "Generated CIB Seven / Camunda 7 REST SDK plus Zod input schemas.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "camunda7",
    "cib-seven",
    "bpmn",
    "rest-client",
    "sdk",
    "mcp"
  ],
  "homepage": "https://github.com/Miragon/miragon-ai/tree/main/packages/connectors/camunda/camunda7-client#readme",
  "bugs": "https://github.com/Miragon/miragon-ai/issues",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/miragon-ai.git",
    "directory": "packages/connectors/camunda/camunda7-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/generated/sdk.gen.d.ts",
      "import": "./dist/generated/sdk.gen.js"
    },
    "./types": {
      "types": "./dist/generated/types.gen.d.ts",
      "import": "./dist/generated/types.gen.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-ts",
    "spec:refresh": "sh ./scripts/refresh-spec.sh",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
