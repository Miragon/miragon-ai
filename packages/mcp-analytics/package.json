{
  "name": "@miragon-ai/mcp-analytics",
  "version": "0.0.0",
  "description": "Prometheus-backed process-analytics MCP module: tools, dashboards, and comparison widgets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/miragon-ai.git",
    "directory": "packages/mcp-analytics"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": "./src/widgets/index.ts",
    "./definition": "./src/definition.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widgets.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@miragon-ai/client-analytics": "workspace:*",
    "@miragon-ai/widget-shell": "workspace:*",
    "@miragon/mcp-toolkit-core": "0.10.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "mcp-use": "1.34.5",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-ui": "0.10.1",
    "@types/react": "19.2.17",
    "bpmn-js": "18.14.0",
    "mcp-use": "1.34.5",
    "react": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
