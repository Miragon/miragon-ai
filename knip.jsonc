{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead-code fitness function (`pnpm lint:deadcode`, part of `pnpm lint`).
  // Every ignore below is a documented exception — the list is shrink-only,
  // same convention as the ESLint ratchet lists.

  // Standalone customer-facing workspace OUTSIDE the pnpm workspace; verified
  // by scripts/test-template.sh against packed tarballs, not this graph.
  "ignore": ["templates/**"],

  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "vitest.shared.ts"],
    },

    "apps/mcp-server-camunda7": {
      // The UI bundle entries are declared explicitly and the vite plugin
      // stays off (historical: the pre-2.x config needed an INPUT env var);
      // the explicit list is stable and cheap to keep.
      "vite": false,
      // No stryker.config.json here: the diff gate only scans packages/*.
      "entry": [
        "src/ui/main.tsx",
        // Parsed statically as an entry so its plugin imports count as used.
        "vite.config.ts",
        "test/**/*.test.ts",
        "test-host/**/*.{ts,mjs}",
      ],
      // Widget-bundle stand-in read at runtime via a path (never imported) by
      // the in-process e2e boots — invisible to the module graph.
      "ignore": ["test/fixtures/**"],
      "ignoreDependencies": [
        // Referenced from src/ui/geist-latin.css (@font-face src url), which
        // the module graph does not traverse.
        "@fontsource-variable/geist",
        // Deliberate resolution pin, never imported: mcp-use 2's graph peers
        // on lucide-react (built-in inspector); without one version pinned
        // next to the toolkit, pnpm splits mcp-use into two peer instances
        // and the view runtime exists twice (migration guide §1).
        "lucide-react",
      ],
    },

    "packages/client-camunda7": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
      // Generated CIB Seven SDK (pnpm generate) — its export surface mirrors
      // the OpenAPI spec, not our usage.
      "ignore": ["src/generated/**"],
    },

    "packages/client-analytics": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/mcp-camunda7": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/mcp-analytics": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/widget-shell": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "docs": {
      "ignoreDependencies": [
        // Lazy-loaded mermaid diagram runtimes (mindmap → cytoscape*,
        // timeline → dayjs, sanitize/debug) — imported by mermaid at render
        // time, never by our code.
        "@braintree/sanitize-url",
        "cytoscape",
        "cytoscape-cose-bilkent",
        "dayjs",
        "debug",
        // Provided by vitepress; the theme imports it directly.
        "vue",
      ],
    },
  },
}
