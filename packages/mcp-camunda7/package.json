{
  "name": "@miragon-ai/mcp-camunda7",
  "version": "0.5.0",
  "description": "Camunda 7 / CIB Seven MCP module: operations tools, widget tools, and cockpit widgets.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "camunda",
    "camunda7",
    "cib-seven",
    "bpmn",
    "widgets"
  ],
  "homepage": "https://github.com/Miragon/miragon-ai/tree/main/packages/mcp-camunda7#readme",
  "bugs": "https://github.com/Miragon/miragon-ai/issues",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/miragon-ai.git",
    "directory": "packages/mcp-camunda7"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": "./src/widgets/index.ts",
    "./definition": "./src/definition.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widgets.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@miragon-ai/client-camunda7": "workspace:*",
    "@miragon-ai/widget-shell": "workspace:*",
    "@miragon/mcp-toolkit-core": "0.10.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "mcp-use": "1.34.5",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-ui": "0.10.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "bpmn-js": "18.14.0",
    "happy-dom": "20.10.2",
    "mcp-use": "1.34.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
