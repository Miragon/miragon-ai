{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "draft": false,
  "bootstrap-sha": "fc210e0965b5e3f40eb632e24b49e947eb7d538e",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "miragon-ai",
      "component": "",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["packages"],
      "extra-files": [
        { "type": "generic", "path": "engine-plugins/gradle.properties" },
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "apps/mcp-server-camunda7/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "packages/client-camunda7": {
      "release-type": "node",
      "component": "client-camunda7",
      "include-component-in-tag": true,
      "release-as": "0.1.0"
    },
    "packages/client-analytics": {
      "release-type": "node",
      "component": "client-analytics",
      "include-component-in-tag": true,
      "release-as": "0.1.0"
    },
    "packages/widget-shell": {
      "release-type": "node",
      "component": "widget-shell",
      "include-component-in-tag": true,
      "release-as": "0.1.0"
    },
    "packages/mcp-camunda7": {
      "release-type": "node",
      "component": "mcp-camunda7",
      "include-component-in-tag": true,
      "release-as": "0.1.0"
    },
    "packages/mcp-analytics": {
      "release-type": "node",
      "component": "mcp-analytics",
      "include-component-in-tag": true,
      "release-as": "0.1.0"
    }
  }
}
