{
  "name": "miragon-ai",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "scripts": {
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://miragon:miragon@localhost:8440/miragon_test} pnpm --filter @miragon-ai/widget-shell --filter @miragon-ai/camunda7-connector --filter @miragon-ai/mcp-server-camunda7 run test",
    "lint": "turbo run lint && pnpm lint:architecture && pnpm lint:naming && pnpm lint:deadcode",
    "lint:architecture": "depcruise apps/*/src packages/core/*/src packages/connectors/*/*/src --config .dependency-cruiser.cjs",
    "lint:naming": "node scripts/check-package-naming.mjs",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "dotenv -e .env -- pnpm --filter @miragon-ai/mcp-server-camunda7 dev",
    "docs:dev": "pnpm --filter @miragon-ai/docs dev",
    "docs:build": "pnpm --filter @miragon-ai/docs build",
    "docs:preview": "pnpm --filter @miragon-ai/docs preview",
    "test:mutation": "node scripts/mutation-diff.mjs",
    "fitness": "node scripts/fitness-report.mjs",
    "lint:deadcode": "knip --exclude exports,types,enumMembers"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "picomatch": "4.0.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
