{
  "name": "@acme/composed-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Composed MCP server: Miragon AI modules (camunda7, analytics) plus the custom notes module.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:ui": "vite build",
    "build:server": "tsc",
    "build": "pnpm run build:ui && pnpm run build:server",
    "dev:ui": "vite build --watch",
    "dev": "pnpm run build:ui && mcp-use dev --port ${PORT:-8400} --no-open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@acme/mcp-notes": "workspace:*",
    "@miragon-ai/analytics-connector": "0.9.0",
    "@miragon-ai/camunda7-connector": "0.9.0",
    "@miragon-ai/widget-shell": "0.9.0",
    "@miragon/mcp-toolkit-core": "2.1.0",
    "mcp-use": "2.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@miragon/mcp-toolkit-ui": "2.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "lucide-react": "0.562.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.4"
  }
}
